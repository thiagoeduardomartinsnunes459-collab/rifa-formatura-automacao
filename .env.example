# Copie este arquivo para .env e preencha com os valores reais.
# Nunca commite o .env de verdade — ele fica de fora do git via .gitignore.

MAKE_API_TOKEN=
MAKE_ZONE=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client ID e Client Secret vêm da tela "Nova Aplicação" no painel web da Efí (sejaefi.com.br).
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=

# Caminho local do certificado .p12 baixado da mesma tela — não o conteúdo do arquivo,
# só o caminho. Salve o arquivo em certs/ (já ignorado pelo git).
EFI_CERT_PATH=./certs/homologacao.p12

# Ambiente Efí: homologacao (sandbox, testar primeiro) ou producao
EFI_AMBIENTE=homologacao
