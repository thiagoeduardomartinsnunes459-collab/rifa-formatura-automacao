# Uso local apenas (vercel dev). Em producao, essas variaveis vao direto no
# painel do Vercel (Settings -> Environment Variables), nunca neste arquivo.
#
# Como gerar os valores a partir do certs/producao.p12 (na raiz do projeto):
#   openssl pkcs12 -in ../certs/producao.p12 -clcerts -nokeys -passin pass: | openssl x509
#   openssl pkcs12 -in ../certs/producao.p12 -nocerts -nodes -passin pass:
#
# Cole o CONTEUDO de cada bloco PEM inteiro (com -----BEGIN...----- e
# -----END...-----) como uma unica linha usando \n pra quebra de linha.

EFI_PROD_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
EFI_PROD_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
